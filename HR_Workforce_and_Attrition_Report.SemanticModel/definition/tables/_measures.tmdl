table _measures
	lineageTag: 605c917c-a440-42ee-aa8b-0b20a49990d3

	measure 'Total Terminations' =
			
			CALCULATE(
			    COUNTROWS(FactEmployeeEvents),
			    FactEmployeeEvents[EventType] = "Termination"
			)
		formatString: 0
		displayFolder: Attrition
		lineageTag: 75263a44-36ee-4105-b9c7-482a636f799b

	measure 'Structural Exits' =
			
			CALCULATE(
			    COUNTROWS(FactEmployeeEvents),
			    FactEmployeeEvents[EventType] = "Termination",
			    FactEmployeeEvents[IsRestructuringExit] = TRUE
			)
		formatString: 0
		displayFolder: Attrition
		lineageTag: ab19409a-c444-4b7e-aa0c-470ca16862e4

	measure 'Organic Terminations' =
			
			CALCULATE(
			    COUNTROWS(FactEmployeeEvents),
