	measure 'Disengaged Employee %' =
			
			VAR _DisengagedCount =
			    CALCULATE(
			        DISTINCTCOUNT( FactEngagement[EmployeeID] ),
			        FactEngagement[EngagementScore] <= 2
			    )
			VAR _TotalSurveyed =
			    DISTINCTCOUNT( FactEngagement[EmployeeID] )
			RETURN
			    DIVIDE( _DisengagedCount, _TotalSurveyed,0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Performance
		lineageTag: 7cad858e-861d-4746-97dc-0f7894c80cd3

	measure 'Avg Days Absent per Employee' =
			
			VAR _TotalDays =
			        SUM( FactAbsence[DaysAbsent] )
			VAR _EmployeeCount =
			        DISTINCTCOUNT( FactAbsence[EmployeeID] )
			RETURN
			    DIVIDE( _TotalDays, _EmployeeCount )
		formatString: 0
		displayFolder: Performance
		lineageTag: 1d4d5438-2eef-4c0b-a1b9-32a3bc4e085a

		annotation PBI_FormatHint = {"isDecimal":true}

