			    FactEmployeeEvents[IsRestructuringExit] = FALSE
			)
		formatString: 0
		displayFolder: Attrition
		lineageTag: 8c540402-2565-4a39-b5ff-8cb6ef94c581

	measure 'Voluntary Exits' =
			
