			```
		displayFolder: FTE
		lineageTag: 751ec560-8d9f-4a7a-ae5d-23c3d7547d81

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'FTE Bullet Chart' =
			
			
			VAR _ActualFTE  = [Current YR FTE]
			VAR _BudgetFTE  = [Current YR Budgeted FTE]
			
			-- Guard against zero budget to avoid division errors
			VAR _SafeBudget = IF(_BudgetFTE = 0, 1, _BudgetFTE)
			
			-- ── Scaling ───────────────────────────────────────────────────────────
			-- Track represents 120% of budget so overstaffing is still visible
			VAR _MaxFTE  = _SafeBudget * 1.20
			VAR _TrackW  = 300
			VAR _Scale   = DIVIDE(_TrackW, _MaxFTE, 0)
			
			-- ── Bar & Marker positions (px) ───────────────────────────────────────
			-- Comparative band: ends exactly at 100% of budget
			VAR _CompW   = MIN(ROUND(_SafeBudget * _Scale, 0), _TrackW)
			
			-- Actual bar: current FTE scaled proportionally, capped at track width
			VAR _ActualW = MIN(MAX(ROUND(_ActualFTE * _Scale, 0), 0), _TrackW)
			
			-- Target line: sits at the budget position (same as _CompW)
			VAR _TargetX = _CompW
			VAR _TriX1   = _TargetX - 6
			VAR _TriX2   = _TargetX + 6
			
			-- ── Actual bar colour (self-explanatory without a legend) ─────────────
			-- 🔴 Red   = understaffed  (actual < 95% of budget)
			-- 🟢 Green = on plan       (within ±5% of budget)
			-- 🔵 Blue  = overstaffed   (actual > 105% of budget)
			VAR _BarColor =
			    SWITCH(
			        TRUE(),
			        _ActualFTE < _SafeBudget * 0.95, "%23C0392B",
			        _ActualFTE > _SafeBudget * 1.05, "%232471A3",
			        "%231F3A2E"
			    )
			
			-- ── Label ─────────────────────────────────────────────────────────────
			-- Shows "999.0 / 1,020.0" (actual / budget)
			VAR _ActualLabel = FORMAT(_ActualFTE,  "#,##0.0")
			VAR _BudgetLabel = FORMAT(_BudgetFTE, "#,##0.0")
			VAR _Label       = _ActualLabel & " / " & _BudgetLabel
			
			RETURN
			"data:image/svg+xml;utf8," &
			"<svg xmlns='http://www.w3.org/2000/svg' width='460' height='24'>" &
			
			-- Background track (full range = 120% of budget)
			"<rect width='" & _TrackW & "' height='24' rx='4' fill='%23F4EFE3'/>" &
			
			-- Comparative band: budget zone (lighter fill, ends at budget)
			"<rect width='" & _CompW & "' height='16' y='4' rx='3' fill='%23B7C2AE'/>" &
			
			-- Actual FTE bar (colour-coded by status)
			"<rect width='" & _ActualW & "' height='8' y='8' rx='2' fill='" & _BarColor & "'/>" &
			
			-- Target marker triangle (downward-pointing arrow at budget line)
			"<polygon points='" & _TriX1 & ",0 " & _TriX2 & ",0 " & _TargetX & ",10' fill='%23B08D3C'/>" &
			
			-- Target marker vertical line
			"<line x1='" & _TargetX & "' y1='0' x2='" & _TargetX & "' y2='24'" &
			" stroke='%23B08D3C' stroke-width='2'/>" &
			
			-- Value label: Actual / Budget
			"<text x='308' y='17' font-family='Inter' font-size='11' fill='%236B6558'>" &
			_Label & "</text>" &
			
			"</svg>"
		lineageTag: e0e8cd38-0252-4be6-82c5-27fc2e79c3dd
		dataCategory: ImageUrl

