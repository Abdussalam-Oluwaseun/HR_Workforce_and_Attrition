	measure 'Current YR FTE' = ```
			
			VAR _CurrentYear = 
			    YEAR(MAX(DimDate[Month]))
			RETURN
			    CALCULATE(
			       [Actual FTE],
			        FILTER(
			            ALL(DimDate),
			            YEAR(DimDate[Month]) = _CurrentYear
			        )
			    )
			```
		displayFolder: FTE
		lineageTag: 91def159-f111-4001-af7c-c8d10581ab36

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Current YR Budgeted FTE' = ```
			
			VAR _CurrentYear = 
			    YEAR(MAX(DimDate[Month]))
			RETURN
			    CALCULATE(
			       [Budgeted FTE],
			        FILTER(
			            ALL(DimDate),
			            YEAR(DimDate[Month]) = _CurrentYear
