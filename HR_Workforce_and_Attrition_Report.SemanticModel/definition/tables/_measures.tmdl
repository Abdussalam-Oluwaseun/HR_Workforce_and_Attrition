	measure 'Avg Monthly Headcount' =
			
			AVERAGEX(
			    VALUES(FactMonthlySnapshot[Month]),
			    CALCULATE(SUM(FactMonthlySnapshot[Headcount]))
			)
		displayFolder: Attrition
		lineageTag: 1e4ba84f-b35e-44a1-b92c-2f09b8dc02f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Attrition Rate (All Exits)' =
			
			DIVIDE(
			    [Total Terminations],
			    [Avg Monthly Headcount],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Attrition
		lineageTag: 3a6a4245-b4b7-4b33-92d6-8032a8f329cd

	measure 'Organic Attrition Rate' =
			
			DIVIDE(
			    [Organic Terminations],
			    [Avg Monthly Headcount],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Attrition
		lineageTag: 467956fc-df63-4a84-8813-01c6d941f73f

	measure 'Voluntary Attrition Rate' =
			
			DIVIDE(
			    [Voluntary Exits],
			    [Avg Monthly Headcount],
			    0
			)
		displayFolder: Attrition
		lineageTag: 20fd7404-a7c2-4bda-a1a9-fb0c99a58fb1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rolling 12M Attrition Rate' = ```
			
			VAR _LastDate =
			    CALCULATE(
			        MAX(DimDate[Date]),
			        ALL(DimDate)      
			    )
			VAR _DateWindow =
			    DATESINPERIOD(
			        DimDate[Date],
			        _LastDate,
			        -12,
			        MONTH
			    )
			VAR _Terminations12M =
			    CALCULATE(
			        [Organic Terminations],
			        _DateWindow
			    )
			VAR _AvgHeadcount12M =
			    CALCULATE(
			        [Avg Monthly Headcount],
			        _DateWindow
			    )
			RETURN
			    DIVIDE(_Terminations12M, _AvgHeadcount12M, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Attrition
		lineageTag: d627cb1f-33db-4da3-a928-aa8aba388f3c

	measure 'Rolling 12M Attrition Rate PY' = ```
			
			VAR _LastDate =
			    CALCULATE(MAX(DimDate[Date]), ALL(DimDate))
			VAR _PriorWindow =
			    DATESINPERIOD(
			        DimDate[Date],
			        EDATE(_LastDate, -12),  
			        -12,
			        MONTH
			    )
			VAR _Terminations_PY =
			    CALCULATE([Organic Terminations], _PriorWindow)
			VAR _AvgHeadcount_PY =
			    CALCULATE([Avg Monthly Headcount], _PriorWindow)
			RETURN
			    DIVIDE(_Terminations_PY, _AvgHeadcount_PY, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Attrition
		lineageTag: c923c906-d467-4bbc-a700-865b33a3a009

	measure 'Attrition Rate YoY Change' =
			
			[Rolling 12M Attrition Rate] - [Rolling 12M Attrition Rate PY]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Attrition
		lineageTag: f1735482-46a5-401d-a7df-d8a874489838

	measure 'Open Requisitions' =
			
			SUM(FactRecruitment[OpenRequisitions])
		formatString: 0
		displayFolder: Requisition
		lineageTag: 349bde0a-88b1-4d7d-b875-63fd68a62dbc

	measure 'Filled Requisitions' =
			
			SUM(FactRecruitment[FilledRequisitions])
		formatString: 0
		displayFolder: Requisition
		lineageTag: 01f72ddd-10b2-4c9f-84b8-921c99f4588e

	measure 'Cancelled Requisitions' =
			
			SUM(FactRecruitment[CancelledRequisitions])
		formatString: 0
		displayFolder: Requisition
		lineageTag: 342c61d1-e4f9-4146-985e-b7d88035de17

	measure 'Unfilled Requisitions' =
			
			[Open Requisitions] - [Filled Requisitions] - [Cancelled Requisitions]
		formatString: 0
		displayFolder: Requisition
		lineageTag: 513e7112-a534-491d-8e8a-28d55b022e5d

	measure 'Net Fill Rate %' = ```
			
			DIVIDE(
			    [Filled Requisitions],
			    [Open Requisitions] - [Cancelled Requisitions],
			    0
			)
			-- Net Fill Rate: Filled ÷ (Open − Cancelled)
			-- Fairer view — removes roles the business chose to cancel
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Requisition
		lineageTag: 5ad4f3d0-95ba-4ced-81e5-4217aeddb1c8

	measure 'Recruitment Fill Rate %' =
			
			DIVIDE(
			    [Filled Requisitions],
			    [Open Requisitions],
			    0
			)
			-- Includes cancelled roles in the denominator (conservative view)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Requisition
		lineageTag: 5c3d93ad-ad03-4aca-b94e-4d68062984c8

	measure 'Avg Days to Fill' =
			
			DIVIDE(
			    SUMX(
			        FactRecruitment,
			        FactRecruitment[AvgDaysToFill] * FactRecruitment[FilledRequisitions]
			    ),
			    [Filled Requisitions],
			    0
			)
		displayFolder: Requisition
		lineageTag: 2c2f216a-e624-445d-9542-91d32b888099

		annotation PBI_FormatHint = {"isGeneralNumber":true}

