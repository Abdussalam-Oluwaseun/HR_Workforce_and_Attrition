	measure 'Headcount Variance' =
			
			VAR _var =[Actual Headcount] - [Budget Headcount]
			RETURN
			    SWITCH(
			        TRUE(),
			        _Var < 0,  FORMAT( ABS( _Var ), "0" ) & " Headcounts short",
			        _Var > 0,  FORMAT( _Var, "0" ) & " Headcounts over",
			                   "On plan"
			    )
		displayFolder: Headcount
		lineageTag: a74819e0-30ee-4d36-87b5-c4d349e4a9a2

	measure 'Headcount Variance %' =
			
			DIVIDE( [Actual Headcount], [Budget Headcount],0)
		displayFolder: Headcount
		lineageTag: 8a3b6642-2fcf-4028-bb38-704399f9413c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'FTE Variance' =
			
			VAR _var = [Actual FTE] - [Budgeted FTE]
			RETURN
			    SWITCH(
			        TRUE(),
			        _Var < 0,  FORMAT( ABS( _Var ), "0" ) & " Below budget",
			        _Var > 0,  FORMAT( _Var, "0" ) & " Above budget",
			                   "On plan"
			    )
		displayFolder: FTE
		lineageTag: c0672933-a554-48c2-a87b-27ded923cec1

	measure 'FTE Variance %' =
			
			DIVIDE( [Actual FTE], [Budgeted FTE],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: FTE
		lineageTag: f53a67e7-51c2-47d9-b08e-39fff2458d22

	measure 'Workforce Status Summary' =
			
			VAR _HCVar      = [Actual Headcount] - [Budget Headcount]
			VAR _FTEVarPct  = DIVIDE( [Actual FTE], [Budgeted FTE],0)
			VAR _SalVar     = [Actual Salary Cost] - [Budgeted Salary Cost]
			VAR _SalAbs     = ABS( _SalVar )
			VAR _SalDir     = IF( _SalVar >= 0, "over", "under" )
			VAR _HCPrefix   = IF( _HCVar >= 0, "+", "" )
			RETURN
			    "Headcount " & _HCPrefix & _HCVar &
			    "  ·  FTE " & FORMAT( _FTEVarPct, "+0.0%;-0.0%;0%" ) &
			    "  ·  Salary €" & FORMAT( _SalAbs / 1000, "0,000.0" ) & "K " & _SalDir & " budget"
		lineageTag: f379eca2-4a80-4708-bda0-870649094524

	measure 'Workforce Overall Insight' =
			
			VAR _HCVar         = [Actual Headcount] - [Budget Headcount]
			VAR _FTEVarPct     = DIVIDE( [Actual FTE], [Budgeted FTE],0)
			VAR _SalUtil       = DIVIDE( [Actual Salary Cost], [Budgeted Salary Cost],0)
			VAR _SalVar        = [Actual Salary Cost] - [Budgeted Salary Cost]
			
			-- Classify headcount severity
			VAR _HCStatus =
			    SWITCH(
			        TRUE(),
			        _HCVar <= -5,  "critical",
			        _HCVar  <  0,  "atrisk",
			        _HCVar  =  0,  "onplan",
			                       "surplus"
			    )
			
			-- Classify FTE severity
			VAR _FTEStatus =
			    SWITCH(
			        TRUE(),
			        _FTEVarPct < -0.10, "critical",
			        _FTEVarPct <  0,    "atrisk",
			        _FTEVarPct <= 0.05, "onplan",
			                            "surplus"
			    )
			
			-- Classify salary budget position
			VAR _SalStatus =
			    SWITCH(
			        TRUE(),
			        _SalUtil > 1.05,  "overspend",
			        _SalUtil >= 0.95, "onbudget",
			                          "underspend"
			    )
			
			-- Combined narrative
			RETURN
			    SWITCH(
			        TRUE(),
			
			        -- Critical understaffing scenarios
			        _HCStatus = "critical" && _SalStatus = "underspend",
			            "🔴 Critical gap: headcount is significantly below plan while salary budget is unspent. " &
			            "Open requisitions are not converting. Escalate recruitment urgency and review pipeline blockers immediately.",
			
			        _HCStatus = "critical" && _SalStatus = "overspend",
			            "🔴 Critical understaffing despite salary overspend — review grade mix and contractor costs. " &
			            "Higher spend per head suggests expensive interim cover. Prioritise permanent hiring to stabilise costs.",
			
			        _HCStatus = "critical" && _SalStatus = "onbudget",
			            "🔴 Significantly below headcount plan. Budget is available. Activate urgent hiring across open roles " &
			            "and escalate to talent acquisition leadership.",
			
			        -- At-risk scenarios
			        _HCStatus = "atrisk" && _SalStatus = "underspend",
			            "🟠 Below headcount plan with unspent salary budget. Headroom exists to hire. " &
			            "Prioritise filling open roles before budget lapses — coordinate with recruitment on active requisitions.",
			
			        _HCStatus = "atrisk" && _SalStatus = "overspend",
			            "🟠 Understaffed but overspending on salary — likely driven by higher-grade hires or pay uplifts. " &
			            "Review compensation mix and ensure new hires align to budgeted levels.",
			
			        _HCStatus = "atrisk" && _SalStatus = "onbudget",
			            "🟠 Slightly below headcount plan but salary is on track. Monitor attrition risk closely " &
			            "and maintain active pipeline to avoid falling further behind plan.",
			
			        -- On plan scenarios
			        _HCStatus = "onplan" && _SalStatus = "onbudget",
			            "🟢 Workforce is on plan across headcount, FTE, and salary. " &
			            "Maintain current hiring pace and review Q-ahead targets to stay ahead of any planned growth.",
			
			        _HCStatus = "onplan" && _SalStatus = "underspend",
			            "🟢 Headcount on plan with salary budget underspend. Consider whether remaining budget " &
			            "should fund competitive pay reviews — underspending on salary increases attrition risk over time.",
			
			        _HCStatus = "onplan" && _SalStatus = "overspend",
			            "🟡 Headcount on plan but salary is over budget. Investigate whether pay uplifts, " &
			            "off-cycle adjustments, or grade drift are driving the overrun.",
			
			        -- Surplus scenarios
			        _HCStatus = "surplus" && _SalStatus = "overspend",
			            "🔵 Overstaffed and over salary budget. Pause new requisition approvals, " &
			            "review redeployment opportunities, and align headcount plan with revised targets.",
			
			        _HCStatus = "surplus" && _SalStatus = "onbudget",
			            "🔵 Headcount above plan but salary within budget — lower average salaries may offset the headcount surplus. " &
			            "Review grade distribution and consider redeployment before any further hiring.",
			
			        _HCStatus = "surplus",
			            "🔵 Headcount above plan. Pause hiring approvals and review whether surplus " &
			            "positions can be redeployed to understaffed departments.",
			
			        -- Fallback
			        "ℹ️ Insufficient data in the selected period to generate a workforce insight. " &
			        "Adjust your date or department filters."
			    )
		lineageTag: c22db33f-d7d2-40d9-9f9e-7f0725795ec5

