	measure 'Headcount Variance Colour' =
			
			VAR _Var = [Actual Headcount] - [Budget Headcount]
			RETURN
			    SWITCH(
			        TRUE(),
			        _Var < 0, "#D64545",   -- red: short-staffed
			        _Var > 0, "#E8A33D",   -- amber: over budget
			        "#2E8B57"              -- green: on plan
			    )
		lineageTag: de1069c5-e7d5-4554-b03a-03a34fb658c2

